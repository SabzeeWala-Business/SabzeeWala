# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Cashfree Payment Gateway Credentials
CASHFREE_LIVE_APP_ID=your-live-app-id
CASHFREE_LIVE_SECRET_KEY=your-live-secret-key
CASHFREE_SANDBOX_APP_ID=your-sandbox-app-id
CASHFREE_SANDBOX_SECRET_KEY=your-sandbox-secret-key
CASHFREE_USE_PRODUCTION=true

# MSG91 OTP Authentication Credentials
MSG91_WIDGET_ID=your-msg91-widget-id
MSG91_AUTH_KEY=your-msg91-auth-key

# Backend API URL
BACKEND_API_URL=http://10.0.2.2:5000
